<Window x:Class="KVNC1EPTestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KV-NC1EP Test Application" Height="750" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10" Background="#F5F5F5">
            <TextBlock Text="PLC連接設置" FontWeight="Bold" FontSize="14"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <TextBlock Text="IP地址:" Width="70" VerticalAlignment="Center"/>
                <TextBox x:Name="IpAddressTextBox" Width="120" Text="192.168.0.10"/>
                <TextBlock Text="端口:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="PortTextBox" Width="60" Text="8501"/>
                <Button x:Name="ConnectButton" Content="連接PLC" Width="100" Margin="15,0,0,0" Click="ConnectButton_Click" Background="#4CAF50" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="基本測試">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="設備操作" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="設備類型:" Width="100"/>
                            <ComboBox x:Name="DeviceTypeComboBox" Width="100"/>
                            <TextBlock Text="起始地址:" Margin="10,0,0,0"/>
                            <TextBox x:Name="StartAddressTextBox" Width="100"/>
                            <TextBlock Text="數量:" Margin="10,0,0,0"/>
                            <TextBox x:Name="CountTextBox" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="寫入值:" Width="100"/>
                            <TextBox x:Name="WriteValueTextBox" Width="100"/>
                            <Button x:Name="WriteButton" Content="寫入" Width="80" Margin="10,0,0,0" Click="WriteButton_Click"/>
                            <Button x:Name="ReadButton" Content="讀取" Width="80" Margin="10,0,0,0" Click="ReadButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="報警監控">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Background="#F0F0F0" Margin="0,0,0,10">
                        <TextBlock Text="R位報警監控" FontWeight="Bold" Foreground="#0066CC"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <Button x:Name="LoadCSVButton" Content="加載CSV配置" Width="120" Margin="0,0,15,0" Click="LoadCSVButton_Click" Background="#4CAF50" Foreground="White"/>
                            <TextBlock x:Name="CSVStatusTextBlock" Text="未加載" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="起始地址:" Margin="5,0,5,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="MonitorStartAddressTextBox" Width="80" Text="0"/>
                            <TextBlock Text="結束地址:" Margin="15,0,5,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="MonitorEndAddressTextBox" Width="80" Text="9915"/>
                            <TextBlock Text="掃描間隔(ms):" Margin="15,0,5,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="MonitorIntervalTextBox" Width="80" Text="1000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Button x:Name="StartMonitorButton" Content="開始監控" Width="100" Margin="0,0,5,0" Click="StartMonitorButton_Click"/>
                            <Button x:Name="StopMonitorButton" Content="停止監控" Width="100" Margin="5,0,5,0" Click="StopMonitorButton_Click" IsEnabled="False"/>
                            <Button x:Name="ClearAlarmsButton" Content="清除報警" Width="100" Margin="5,0,0,0" Click="ClearAlarmsButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Background="#E8F4F8" Margin="0,0,0,10">
                        <TextBlock Text="Zone數據監控" FontWeight="Bold" Foreground="#0066CC"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="Excel保存路徑:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ZoneSavePathTextBox" Width="350" IsReadOnly="True" VerticalAlignment="Center"/>
                            <Button x:Name="SelectPathButton" Content="選擇路徑" Width="100" Margin="10,0,15,0" Click="SelectPathButton_Click"/>
                            <CheckBox x:Name="EndianModeCheckBox" Content="Big Endian模式" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock x:Name="ZoneStatusTextBlock" Text="未啟動" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ActiveAlarmsDataGrid" Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding Timestamp}" Width="130"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="70"/>
                            <DataGridTextColumn Header="異常名稱" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="詳細內容" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="PLC控制&PC模擬">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="PLC控制命令" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="ServoOnButton" Content="全軸伺服啟動" Width="150" Margin="0,0,10,0" Click="ServoOnButton_Click" Background="#FF9800" Foreground="White"/>
                                <TextBlock Text="MR10200 = ON" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="HomeReturnButton" Content="原點復歸" Width="150" Margin="0,0,10,0" Click="HomeReturnButton_Click" Background="#2196F3" Foreground="White"/>
                                <TextBlock Text="MR30000 = ON (PLC會自動清除)" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="PC自動回應模擬" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="EnablePCResponseCheckBox" Content="啟用模擬PC回應" VerticalAlignment="Center" Margin="0,0,20,0" Checked="EnablePCResponseCheckBox_Changed" Unchecked="EnablePCResponseCheckBox_Changed"/>
                                <TextBlock Text="回應延遲:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="ResponseDelayTextBox" Width="80" Text="500" VerticalAlignment="Center"/>
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="5,0,20,0"/>
                                <TextBlock Text="回應計數:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="ResponseCountTextBlock" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4CAF50"/>
                                <Button x:Name="ResetCountButton" Content="重置" Width="60" Margin="10,0,0,0" Click="ResetCountButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="監控9組拍照Trigger，自動發送Response（上升沿觸發）" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="操作日誌">
                        <TextBox x:Name="ControlLogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
