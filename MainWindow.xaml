<Window x:Class="KVNC1EPTestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KV-NC1EP Test Application" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="10">
            <TextBlock Text="連接設置" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="IP地址:" Width="100"/>
                <TextBox x:Name="IpAddressTextBox" Width="150" Text="192.168.0.10"/>
                <TextBlock Text="端口:" Margin="10,0,0,0"/>
                <TextBox x:Name="PortTextBox" Width="50" Text="8501"/>
                <Button x:Name="ConnectButton" Content="連接" Width="80" Margin="10,0,0,0" Click="ConnectButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="10">
            <TextBlock Text="操作設置" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="設備類型:" Width="100"/>
                <ComboBox x:Name="DeviceTypeComboBox" Width="100"/>
                <TextBlock Text="起始地址:" Margin="10,0,0,0"/>
                <TextBox x:Name="StartAddressTextBox" Width="100"/>
                <TextBlock Text="數量:" Margin="10,0,0,0"/>
                <TextBox x:Name="CountTextBox" Width="100"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10">
            <TextBlock Text="寫入操作" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="寫入值:" Width="100"/>
                <TextBox x:Name="WriteValueTextBox" Width="100"/>
                <Button x:Name="WriteButton" Content="寫入" Width="80" Margin="10,0,0,0" Click="WriteButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
            <TextBlock Text="讀取操作" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="ReadButton" Content="讀取" Width="80" Click="ReadButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="10" Background="#F0F0F0">
            <TextBlock Text="持續監控設置" FontWeight="Bold" Foreground="#0066CC"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <TextBlock Text="監控區域:" Width="100"/>
                <TextBlock Text="起始地址:" Margin="5,0,5,0"/>
                <TextBox x:Name="MonitorStartAddressTextBox" Width="80" Text="0"/>
                <TextBlock Text="結束地址:" Margin="15,0,5,0"/>
                <TextBox x:Name="MonitorEndAddressTextBox" Width="80" Text="9915"/>
                <TextBlock Text="掃描間隔(ms):" Margin="15,0,5,0"/>
                <TextBox x:Name="MonitorIntervalTextBox" Width="80" Text="1000"/>
                <Button x:Name="StartMonitorButton" Content="開始監控" Width="100" Margin="15,0,5,0" Click="StartMonitorButton_Click"/>
                <Button x:Name="StopMonitorButton" Content="停止監控" Width="100" Margin="5,0,5,0" Click="StopMonitorButton_Click" IsEnabled="False"/>
                <Button x:Name="ClearAlarmsButton" Content="清除報警" Width="100" Margin="5,0,0,0" Click="ClearAlarmsButton_Click"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="活動報警" Margin="0,0,5,0">
                <DataGrid x:Name="ActiveAlarmsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="時間" Binding="{Binding Timestamp}" Width="130"/>
                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80"/>
                        <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="操作日誌" Margin="5,0,0,0">
                <TextBox x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>